{
  "name": "tickdeck-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "build:examples": "pnpm -r --filter \"./examples/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "dev:vanilla": "pnpm build && pnpm --filter example-vanilla dev",
    "dev:react": "pnpm build && pnpm --filter example-react dev",
    "dev:vue": "pnpm build && pnpm --filter example-vue dev",
    "clean": "rm -rf packages/*/dist packages/*/coverage examples/*/dist",
    "changeset": "changeset",
    "release": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm typecheck && pnpm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  }
}
