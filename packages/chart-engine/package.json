{
  "name": "@tickdeck/chart-engine",
  "version": "0.0.0",
  "description": "Canvas chart rendering engine for tickdeck, derived from KLineChart.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/chart-engine"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs NOTICE",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
