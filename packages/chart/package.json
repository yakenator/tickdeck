{
  "name": "@tickdeck/chart",
  "version": "0.1.0-alpha.0",
  "description": "Price chart for tickdeck: styles, price scales, history paging, realtime bars and a trading overlay for orders, exits and positions.",
  "keywords": [
    "tickdeck",
    "trading",
    "chart",
    "candlestick",
    "financial-chart",
    "ohlc",
    "order-lines",
    "trading-chart"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/chart#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/chart"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tickdeck/broker": "workspace:*",
    "@tickdeck/chart-engine": "workspace:*",
    "@tickdeck/core": "workspace:*",
    "@tickdeck/datafeed": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
