{
  "name": "@tickdeck/core",
  "version": "0.1.0-alpha.0",
  "description": "Trading types, exact decimal math for prices and quantities, trading sessions, typed events and observable values for tickdeck.",
  "keywords": [
    "tickdeck",
    "trading",
    "decimal",
    "orders",
    "instruments",
    "typescript"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/core#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
