    "tickdeck",
    "trading",
    "market-data",
    "datafeed",
    "ohlc",
    "candles",
    "quotes",
    "order-book"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/datafeed#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/datafeed"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
