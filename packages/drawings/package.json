{
  "name": "@tickdeck/drawings",
  "version": "0.0.0",
  "description": "Drawing tools for tickdeck charts (planned for P2; type sketches only).",
  "keywords": [
    "tickdeck",
    "trading",
    "chart",
    "drawings",
    "technical-analysis"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/drawings#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/drawings"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tickdeck/chart": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
