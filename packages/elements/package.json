{
  "name": "@tickdeck/elements",
  "version": "0.1.0-alpha.1",
  "description": "tickdeck trading widgets as standard Web Components: order ticket, account panel, trade buttons and notifications.",
  "keywords": [
    "tickdeck",
    "trading",
    "web-components",
    "custom-elements",
    "lit",
    "order-ticket",
    "trading-ui"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/elements#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/elements"
  },
  "type": "module",
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tickdeck/widgets-core": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tickdeck/broker": "workspace:*",
    "@tickdeck/core": "workspace:*",
    "@tickdeck/datafeed": "workspace:*",
    "axe-core": "^4.14.0",
    "happy-dom": "^20.14.6",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
