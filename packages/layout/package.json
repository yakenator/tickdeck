{
  "name": "@tickdeck/layout",
  "version": "0.1.0-alpha.1",
  "description": "Multi-chart layouts with linked charts for tickdeck (planned for P2; type sketches only).",
  "keywords": [
    "tickdeck",
    "trading",
    "chart",
    "layout",
    "multi-chart"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/layout#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/layout"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tickdeck/chart": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
