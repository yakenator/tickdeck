{
  "name": "@tickdeck/layout",
  "version": "0.0.0",
  "description": "Multi-chart layouts with linked charts for tickdeck.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/layout"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tickdeck/chart": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
