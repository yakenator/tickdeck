{
  "name": "@tickdeck/react",
  "version": "0.0.0",
  "description": "React components for tickdeck.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/react"
  },
  "type": "module",
