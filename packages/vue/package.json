{
  "name": "@tickdeck/vue",
  "version": "0.1.0-alpha.1",
  "description": "Vue 3 components for the tickdeck trading widgets.",
  "keywords": [
    "tickdeck",
    "trading",
    "vue",
    "trading-ui",
    "order-ticket",
    "web-components"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/vue#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tickdeck/elements": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@tickdeck/broker": "workspace:*",
    "@tickdeck/datafeed": "workspace:*",
    "happy-dom": "^20.14.6",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
