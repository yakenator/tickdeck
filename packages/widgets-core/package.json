{
  "name": "@tickdeck/widgets-core",
  "version": "0.0.0",
  "description": "Headless controllers for the tickdeck trading widgets: account panel, order ticket, trade buttons and notifications.",
  "keywords": [
    "tickdeck",
    "trading",
    "headless",
    "order-ticket",
    "account-panel",
    "controllers",
    "widgets"
  ],
  "homepage": "https://github.com/yakenator/tickdeck/tree/main/packages/widgets-core#readme",
  "bugs": "https://github.com/yakenator/tickdeck/issues",
  "license": "Apache-2.0",
  "author": "yakenator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakenator/tickdeck.git",
    "directory": "packages/widgets-core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-legal.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tickdeck/core": "workspace:*",
    "@tickdeck/broker": "workspace:*",
    "@tickdeck/datafeed": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
