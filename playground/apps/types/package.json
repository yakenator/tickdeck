    "@tickdeck/chart": "0.1.0-alpha.2",
    "@tickdeck/core": "0.1.0-alpha.2",
    "@tickdeck/datafeed": "0.1.0-alpha.2",
    "@tickdeck/elements": "0.1.0-alpha.2",
    "@tickdeck/react": "0.1.0-alpha.2",
    "@tickdeck/vue": "0.1.0-alpha.2",
    "@tickdeck/widgets-core": "0.1.0-alpha.2",
    "react": "^19.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~5.9.3"
