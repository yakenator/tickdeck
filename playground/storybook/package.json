{
  "name": "playground-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook for the published tickdeck elements and chart: deterministic states, interaction tests and accessibility checks.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist",
    "build": "storybook build --quiet -o dist",
    "typecheck": "tsc --noEmit",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@tickdeck/broker": "0.1.0-alpha.1",
    "@tickdeck/chart": "0.1.0-alpha.1",
    "@tickdeck/core": "0.1.0-alpha.1",
    "@tickdeck/datafeed": "0.1.0-alpha.1",
    "@tickdeck/elements": "0.1.0-alpha.1",
    "@tickdeck/widgets-core": "0.1.0-alpha.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/web-components-vite": "10.6.2",
    "@vitest/browser-playwright": "5.0.4",
    "playwright": "1.64.0",
    "storybook": "10.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
